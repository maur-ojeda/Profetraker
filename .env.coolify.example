# =============================================================================
# Profe Tracker — Coolify / Self-hosted environment variables
# =============================================================================
# Copy this file to .env.coolify and fill in the real values before
# deploying through Coolify. Coolify will inject these into the
# Supabase stack and the Next.js app.
#
# Security notes:
#   - NEVER commit .env.coolify (it is gitignored).
#   - All "SECRET" values should be generated with `openssl rand -hex 32`.
#   - The ANON_KEY and SERVICE_ROLE_KEY below are derived from JWT_SECRET.
#     If you change JWT_SECRET, regenerate the keys (see COOLIFY.md).
# =============================================================================

############
# Required #
############

# --- Supabase stack ---
POSTGRES_PASSWORD=change-me-to-a-strong-password
JWT_SECRET=replace-with-openssl-rand-hex-32
ANON_KEY=
SERVICE_ROLE_KEY=
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-too
SECRET_KEY_BASE=replace-with-openssl-rand-hex-64
VAULT_ENC_KEY=replace-with-openssl-rand-hex-32
PG_META_CRYPTO_KEY=replace-with-openssl-rand-hex-32

# --- Public URLs ---
# SITE_URL: where Supabase redirects users after email confirmation.
#   - In Coolify with a domain: https://profe-tracker.tudominio.com
#   - In Coolify on local IP only: http://192.168.1.96:3000
SITE_URL=http://192.168.1.96:3000

# API_EXTERNAL_URL: how the Next.js app (running in another container) reaches
# Supabase. Since both are on Coolify's default Docker network, use the
# kong service name + port. KONG_HTTP_PORT defaults to 8000.
API_EXTERNAL_URL=http://supabase-kong:8000

# SUPABASE_PUBLIC_URL: how the browser reaches Supabase from outside Docker.
#   - Local network: http://192.168.1.96:8000
#   - Public domain: https://supabase.tudominio.com (with HTTPS proxy in Coolify)
SUPABASE_PUBLIC_URL=http://192.168.1.96:8000

# --- Next.js app ---
# These three are also passed to the Next.js container.
NEXT_PUBLIC_SUPABASE_URL=http://192.168.1.96:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=
GEMINI_API_KEY=your-gemini-api-key-from-google-ai-studio

############
# Optional #
############

# Disable self-service signup. Recommended for production / demos.
DISABLE_SIGNUP=false

# Auto-confirm email signups (no email verification flow). Useful for demos
# where you don't want to configure SMTP.
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=true

# JWT expiry in seconds (default 3600 = 1 hour)
JWT_EXPIRY=3600

# Postgres internal port (exposed by Supavisor pooler)
POSTGRES_PORT=5432
POSTGRES_HOST=db
POSTGRES_DB=postgres

# KONG (API gateway) ports on the host
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# Pooler
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_TENANT_ID=default
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5
POOLER_PROXY_PORT_TRANSACTION=6543

# Storage
STORAGE_BACKEND=file
GLOBAL_S3_BUCKET=storage
STORAGE_TENANT_ID=default
REGION=local
IMGPROXY_AUTO_WEBP=true
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=

# Schemas exposed by PostgREST
PGRST_DB_SCHEMAS=public,storage
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions

# Studio labels
STUDIO_DEFAULT_ORGANIZATION=Profe Tracker
STUDIO_DEFAULT_PROJECT=profe-tracker

# Functions
FUNCTIONS_VERIFY_JWT=false

# --- Supabase keep-alive (used by the app's /api/cron/keep-alive route) ---
# Generated with: openssl rand -hex 32
CRON_SECRET=replace-with-openssl-rand-hex-32

# --- Misc ---
# When true, the login page shows the dev "create admin user" button.
# Set to false for any deploy that other people will see.
NEXT_PUBLIC_DEV_MODE=false

# Microsoft Clarity (optional analytics). Get the project ID from
# https://clarity.microsoft.com — leave empty to disable.
NEXT_PUBLIC_CLARITY_ID=
